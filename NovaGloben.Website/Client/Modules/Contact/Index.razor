@namespace NovaGloben.Website.Client.Modules.Contact
@inherits ModuleBase
@using NovaGloben.Website.Contact

@* A plain HTML form: it posts to the server's handler, which answers with a redirect back here carrying only a status.
   The browser checks the fields first (required, type, length) and the server checks them again. Turnstile's widget
   needs JavaScript; without it the form says so and offers the email address. *@
<section class="ng-section ng-section-tight" aria-labelledby="contact-form-heading">
    <div class="ng-container ng-narrow">
        <h2 id="contact-form-heading">@_text.Heading</h2>

        @if (_status != null)
        {
            <div id="contact-status" class="ng-alert @(_status == ContactKeys.StatusSent ? "ng-alert-ok" : "ng-alert-error")"
                 role="@(_status == ContactKeys.StatusSent ? "status" : "alert")" tabindex="-1">
                <p>@_text.Status[_status]</p>
            </div>
        }

        <form class="ng-form" method="post" action="@_action" novalidate="@false">
            <input type="hidden" name="__RequestVerificationToken" value="@SiteState.AntiForgeryToken" />
            <p class="ng-muted">@_text.Intro</p>

            <div class="ng-field">
                <label for="contact-name">@_text.Name <span aria-hidden="true">*</span></label>
                <input id="contact-name" name="@ContactKeys.Name" type="text" required maxlength="@ContactKeys.NameMax" autocomplete="name" />
            </div>
            <div class="ng-field">
                <label for="contact-email">@_text.Email <span aria-hidden="true">*</span></label>
                <input id="contact-email" name="@ContactKeys.Email" type="email" required maxlength="@ContactKeys.EmailMax" autocomplete="email" />
            </div>
            <div class="ng-field">
                <label for="contact-company">@_text.Company <span class="ng-muted">(@_text.Optional)</span></label>
                <input id="contact-company" name="@ContactKeys.Company" type="text" maxlength="@ContactKeys.CompanyMax" autocomplete="organization" />
            </div>
            <div class="ng-field">
                <label for="contact-topic">@_text.Topic <span class="ng-muted">(@_text.Optional)</span></label>
                <select id="contact-topic" name="@ContactKeys.Topic">
                    <option value="">@_text.TopicNone</option>
                    @foreach (var topic in ContactKeys.Topics)
                    {
                        <option value="@topic" selected="@(topic == _topic)">@_text.Topics[topic]</option>
                    }
                </select>
            </div>
            <div class="ng-field">
                <label for="contact-message">@_text.Message <span aria-hidden="true">*</span></label>
                <textarea id="contact-message" name="@ContactKeys.Message" rows="7" required minlength="@ContactKeys.MessageMin" maxlength="@ContactKeys.MessageMax" aria-describedby="contact-message-hint"></textarea>
                <p id="contact-message-hint" class="ng-field-hint">@_text.MessageHint</p>
            </div>

            @* The honeypot: out of sight and out of the tab order; a person never fills it. *@
            <div class="ng-honeypot" aria-hidden="true">
                <label for="contact-website">@_text.HoneypotLabel</label>
                <input id="contact-website" name="@ContactKeys.Honeypot" type="text" tabindex="-1" autocomplete="off" />
            </div>

            @if (_siteKey.Length > 0)
            {
                <div class="cf-turnstile" data-sitekey="@_siteKey" data-language="@_language" data-theme="light" data-response-field-name="@ContactKeys.TurnstileResponse"></div>
            }
            <noscript><p class="ng-field-hint">@_text.NoScript <a href="mailto:info@nova-globen.se">info@nova-globen.se</a>.</p></noscript>

            <p class="ng-field-hint">@_text.Privacy <a href="@_privacy">@_text.PrivacyLink</a>.</p>
            <button type="submit" class="ng-btn ng-btn-primary">@_text.Send</button>
        </form>
    </div>
</section>

@code {
    public override string RenderMode => RenderModes.Static;

    private ContactText _text = ContactText.English;
    private string _status;
    private string _topic;
    private string _action = "/" + ContactKeys.PostPath;
    private string _privacy = "/privacy";
    private string _siteKey = "";
    private string _language = "en";

    protected override void OnParametersSet()
    {
        _text = ContactText.For(PageState.Site.CultureCode);
        _language = _text == ContactText.Swedish ? "sv" : "en";
        var root = string.IsNullOrEmpty(PageState.Alias.Path) ? "/" : "/" + PageState.Alias.Path + "/";
        _action = root + ContactKeys.PostPath;
        _privacy = root + "privacy";
        _status = PageState.QueryString.TryGetValue(ContactKeys.StatusParameter, out var status) && _text.Status.ContainsKey(status) ? status : null;
        // A link may choose the topic (/contact?topic=tond); only a known topic is taken.
        _topic = PageState.QueryString.TryGetValue(ContactKeys.Topic, out var topic) && ContactKeys.Topics.Contains(topic) ? topic : null;
        _siteKey = ModuleState.Settings != null && ModuleState.Settings.TryGetValue(ContactKeys.TurnstileSiteKeySetting, out var key) ? key ?? "" : "";
        if (_siteKey.Length > 0)
        {
            // Cloudflare's widget, on this page only. Loaded from the head: a component cannot hold a script element.
            AddHeadContent("<script src=\"https://challenges.cloudflare.com/turnstile/v0/api.js\" async defer></script>");
        }
    }
}
