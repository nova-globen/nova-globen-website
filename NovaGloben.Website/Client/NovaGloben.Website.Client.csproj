<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The app's WebAssembly client: its modules' and themes' components, and the runtime a WebAssembly site's
       browser downloads. Program.cs hands the start to Stomme's client. It was once a Razor class library, when
       the framework's client package carried a _framework/blazor.webassembly.js of its own that collided with this project's;
       the package no longer does, and as a library this app had no runtime to serve - a WebAssembly site answered
       _framework/dotnet.js with 404. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyName>NovaGloben.Website.Client.Stomme</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- Modules are streamed to the browser and loaded at run time, so nothing may be trimmed away from under them. -->
    <PublishTrimmed>false</PublishTrimmed>
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\NovaGloben.Website.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Stomme.Client" />
  </ItemGroup>

</Project>
