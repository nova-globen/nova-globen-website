<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests of the website's own code: the content and manifests in the repository, the article import and
       rendering, the old site's addresses, the sitemap and the head tags. Run by scripts/gate.ps1. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Server\NovaGloben.Website.Server.csproj" />
  </ItemGroup>

  <!-- The server runs on the ASP.NET Core shared framework; so do its tests. With it, restore leaves out the packages
       the framework already provides, as it does for the server - without it, the SAML library's old dependency chain
       (System.Security.Cryptography.Xml 4.7.1 down to System.Drawing.Common 4.7.0) came back in the tests alone. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
