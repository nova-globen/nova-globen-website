<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Lek's client: the game list and one module per game, each framing a static game page from this library's wwwroot,
    served at /_content/Lek.Client.Stomme/. A game page is addressed with a hash of its content.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyName>Lek.Client.Stomme</AssemblyName>
    <RootNamespace>Lek</RootNamespace>
    <Nullable>disable</Nullable>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Stomme.Client" />
  </ItemGroup>

  <!-- The content hash of each game page and the site stylesheet, baked in at build time: a changed page gets a new address. -->
  <Target Name="LekAssetHashes" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_LekAssetHashes>$(ProjectDir)$(IntermediateOutputPath)LekAssetHashes.g.cs</_LekAssetHashes>
    </PropertyGroup>
    <ItemGroup>
      <_LekPageFound Include="wwwroot\games\**\*.html;wwwroot\games\site.css" />
      <_LekPage Include="@(_LekPageFound)" Rel="games/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <GetFileHash Files="@(_LekPage)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_LekHashed" />
    </GetFileHash>
    <ItemGroup>
      <_LekAssetLine Include="@(_LekHashed->'        [&quot;%(Rel)&quot;] = &quot;%(FileHash)&quot;,')" />
    </ItemGroup>
    <WriteLinesToFile File="$(_LekAssetHashes)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// generated by Lek.Client.csproj (LekAssetHashes) - do not edit;namespace Lek%3B;public static partial class LekAssets;{;    private static readonly System.Collections.Generic.Dictionary&lt;string, string&gt; Hashes = new(System.StringComparer.Ordinal);    {;@(_LekAssetLine->Replace('\', '/'));    }%3B;}" />
    <ItemGroup>
      <Compile Include="$(_LekAssetHashes)" Exclude="@(Compile)" />
      <FileWrites Include="$(_LekAssetHashes)" />
    </ItemGroup>
  </Target>

</Project>
