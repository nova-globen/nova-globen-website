@namespace Lek.Module.Fuse
@inherits ModuleBase

@* The game is a static canvas page (wwwroot/games/fuse/) talking to the Fuse SignalR hub; this module frames it. A
   signed-in user's display name is passed along so the lobby is prefilled; the hub itself trusts only the cookie. *@
<div class="lek-game-frame">
    <iframe src="@Source" title="Fuse" allow="autoplay; fullscreen" allowfullscreen loading="eager"></iframe>
</div>

@code {
    public override string RenderMode => RenderModes.Static;

    private string Source
    {
        get
        {
            var parts = new List<string>();
            var name = PageState?.User?.DisplayName;
            if (!string.IsNullOrEmpty(name)) parts.Add("name=" + Uri.EscapeDataString(name));
            if (PageState?.QueryString != null && PageState.QueryString.TryGetValue("room", out var room) && !string.IsNullOrEmpty(room))
            {
                parts.Add("room=" + Uri.EscapeDataString(room));
            }
            return LekAssets.Frame("games/fuse/index.html", PageState?.Alias, parts);
        }
    }
}
