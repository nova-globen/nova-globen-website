<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Delato as a module of this host: shared expenses - its API, storage, import and the /delato site's setup; it
    references the web client so the client ships with it. Switched per host by module.delato.enabled (off on production). The assembly name
    ends in .Stomme, which the host's module scan requires.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyName>Delato.Server.Stomme</AssemblyName>
    <RootNamespace>Delato.Server</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Stomme.Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Delato.Shared.csproj" />
    <ProjectReference Include="..\Client\Delato.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Delato.Tests" />
  </ItemGroup>

</Project>
