<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Delato's web client: one module (the ledger) as a Razor class library the host finds like any module's client
    assembly (its name ends in .Stomme). Its wwwroot is served at /_content/Delato.Client.Stomme/. Its texts are in
    Resources/DelatoText.resx (English, the default) and DelatoText.fa.resx (Persian).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyName>Delato.Client.Stomme</AssemblyName>
    <RootNamespace>Delato</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Stomme.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Delato.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Delato.Tests" />
  </ItemGroup>

</Project>
