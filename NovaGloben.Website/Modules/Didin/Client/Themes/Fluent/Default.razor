@namespace Didin.Theme.Fluent
@inherits ThemeBase
@using Didin.Module.Media

<main role="main">
    <header class="bin-topbar">
        @* On the catalog page the app draws its own sidebar with the brand (Module.css hides this one there and floats
           the account controls top right); admin pages keep this header. *@
        <a class="bin-brand" href="@(DidinAssets.SiteBase(PageState.Alias) + "/")"><BinLogo /><span>@ShortName(PageState.Site.Name)</span></a>
        <Menu Orientation="Horizontal" />
        <div class="bin-topbar-actions">
            <UserProfile ShowRegister="@_register" />
            <Login ShowLogin="@_login" />
            <ControlPanel />
        </div>
    </header>

    <div class="bin-content">
        <Pane Name="@PaneNames.Admin" />
        <Pane Name="Default" />
        <Pane Name="Top Full Width" />
        <div class="row">
            <div class="col-md-12">
                <Pane Name="Top 100%" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <Pane Name="Left 50%" />
            </div>
            <div class="col-md-6">
                <Pane Name="Right 50%" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <Pane Name="Left 33%" />
            </div>
            <div class="col-md-4">
                <Pane Name="Center 33%" />
            </div>
            <div class="col-md-4">
                <Pane Name="Right 33%" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <Pane Name="Left 25%" />
            </div>
            <div class="col-md-6">
                <Pane Name="Center 50%" />
            </div>
            <div class="col-md-3">
                <Pane Name="Right 25%" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <Pane Name="Bottom 100%" />
            </div>
        </div>
        <Pane Name="Bottom Full Width" />
    </div>
</main>

@code {
    // "Nova Globen Didin" in titles, "Didin" where the sidebar is narrow
    private static string ShortName(string name) =>
        name != null && name.StartsWith("Nova Globen ", System.StringComparison.Ordinal) ? name["Nova Globen ".Length..] : name;

    public override string Name => "Didin Fluent";

    public override string Panes => PaneNames.Admin +
        ",Default,Top Full Width,Top 100%,Left 50%,Right 50%," +
        "Left 33%,Center 33%,Right 33%,Left 25%,Center 50%,Right 25%," +
        "Bottom 100%,Bottom Full Width";

    private bool _login = true;
    private bool _register = false; // registration is disabled site-wide
}
