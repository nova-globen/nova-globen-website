<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Didin's client: the Media and Login modules, the Fluent theme and the UI they share, as a Razor class library the
    host finds like any module's client assembly (its name ends in .Stomme). Its wwwroot is served at
    /_content/Didin.Client.Stomme/, and every file there is addressed with a hash of its content.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyName>Didin.Client.Stomme</AssemblyName>
    <RootNamespace>Didin</RootNamespace>
    <Nullable>disable</Nullable>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Stomme.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Didin.Shared.csproj" />
    <ProjectReference Include="..\Ui\Didin.Ui.csproj" />
  </ItemGroup>

  <!-- The content hash of each static file, baked in at build time: a changed file gets a new address. -->
  <Target Name="DidinAssetHashes" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_DidinAssetHashes>$(ProjectDir)$(IntermediateOutputPath)DidinAssetHashes.g.cs</_DidinAssetHashes>
    </PropertyGroup>
    <GetFileHash Files="wwwroot\Theme.css;wwwroot\Module.css;wwwroot\qr-link.js" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_DidinAsset" />
    </GetFileHash>
    <ItemGroup>
      <_DidinAssetLine Include="@(_DidinAsset->'            &quot;%(Filename)%(Extension)&quot; =&gt; &quot;%(FileHash)&quot;,')" />
    </ItemGroup>
    <WriteLinesToFile File="$(_DidinAssetHashes)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// generated by Didin.Client.csproj (DidinAssetHashes) - do not edit;namespace Didin%3B;public static partial class DidinAssets;{;    private static string Hash(string file) => (file switch;        {;@(_DidinAssetLine);            _ => &quot;000000000000&quot;,;        })[..12].ToLowerInvariant()%3B;}" />
    <ItemGroup>
      <Compile Include="$(_DidinAssetHashes)" Exclude="@(Compile)" />
      <FileWrites Include="$(_DidinAssetHashes)" />
    </ItemGroup>
  </Target>

</Project>
