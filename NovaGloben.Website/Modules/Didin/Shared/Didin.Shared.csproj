<Project Sdk="Microsoft.NET.Sdk">

  <!-- Didin's catalogue models, shared by its server and its client. Framework-free on purpose. The assembly name ends
       in .Stomme, which the host's module scan requires. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyName>Didin.Shared.Stomme</AssemblyName>
    <RootNamespace>Didin.Shared</RootNamespace>
  </PropertyGroup>

</Project>
