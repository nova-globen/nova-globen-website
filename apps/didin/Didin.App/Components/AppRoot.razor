@namespace Didin.App.Components
@inject Didin.App.Services.ISignIn SignIn
@inject Didin.Module.Media.Services.MediaOptions Options

@* The module's own catalogue (Modules/Didin/Ui) in the app's window. A guest browses what the site opens to guests (a
   public catalogue, as production's sample); signing in goes through the site's own sign-in in the browser
   (Services/SignIn.cs), and the last session is picked up when the app starts.
   A <main>, like the site's page body, so the module's catalogue-page rules apply here too. *@
<main class="bin-maui">
    <header class="bin-topbar">
        <span class="bin-brand"><BinLogo /><span>Didin</span></span>
        <div class="bin-topbar-actions">
            @if (SignIn.IsSignedIn)
            {
                @if (SignIn.UserName != null)
                {
                    <span class="bin-user">@SignIn.UserName</span>
                }
                <FluentButton Appearance="ButtonAppearance.Default" OnClick="SignOutAsync" Disabled="@_busy">Sign out</FluentButton>
            }
            else if (_ready)
            {
                <FluentButton Appearance="ButtonAppearance.Default" OnClick="SignInAsync" Disabled="@_busy">Sign in</FluentButton>
            }
        </div>
    </header>
    @if (_note != null)
    {
        <p class="bin-maui-note" role="status">@_note</p>
    }
    <div class="bin-maui-content">
        @if (_ready)
        {
            <CatalogHost @key="_session" />
        }
    </div>
</main>

@code {
    private bool _ready;
    private bool _busy;
    private string _note;
    private int _session;   // a new value rebuilds the catalogue for the new identity

    protected override async Task OnInitializedAsync()
    {
        await SignIn.RestoreAsync();
        Options.Guest = !SignIn.IsSignedIn;
        _ready = true;
    }

    private async Task SignInAsync()
    {
        _busy = true;
        try
        {
            _note = await SignIn.SignInAsync();
            if (_note == null)
            {
                Options.Guest = false;
                _session++;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignOutAsync()
    {
        _busy = true;
        try
        {
            await SignIn.SignOutAsync();
            Options.Guest = true;
            _note = null;
            _session++;
        }
        finally
        {
            _busy = false;
        }
    }
}
