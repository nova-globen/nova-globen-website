<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android TV: no touchscreen needed, the leanback launcher shows the banner -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:allowBackup="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round"
                 android:banner="@drawable/banner" android:supportsRtl="true"
                 android:networkSecurityConfig="@xml/network_security_config">
        <!-- cast to TV: Google's Cast framework reads its options from this class -->
        <meta-data android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
                   android:value="se.novaglobenab.didin.CastOptionsProvider" />
    </application>
    <!-- signing in opens the site's sign-in page in a Custom Tab (Android 11+ must declare it can see one) -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
